---
type Props = {
	src: string;
}

const { src } = Astro.props;
---

<style lang="scss">
	.video-aspect {
		position: relative;
		width: 100%;
		height: 0;
		padding-bottom: 56%;
		min-height: 300px;
		box-sizing: border-box;
		margin-bottom: 1em;

		> iframe {
			position: absolute;
			width: 100%;
			height: 100%;
			left: 0;
			top: 0;
			border: none;
		}
	}
</style>


<div class="video-aspect">
	<iframe src={src} allowfullscreen />
</div>